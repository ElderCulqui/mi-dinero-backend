// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String?
  timezone   String     @default("America/Lima")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  accounts      Account[]
  categories    Category[]
  billingCycles BillingCycle[]
  transactions  Transaction[]
  transfers     Transfer[]
  loans         Loan[]
  contacts      Contact[]
  creditCards   CreditCard[]
  installmentPlans  InstallmentPlan[]
  recurringExpenses RecurringExpense[]
  contactDebts      ContactDebt[]

  @@map("users")
}

enum AccountType {
  efectivo
  cuenta_bancaria
  tarjeta_credito
}

enum TransactionType {
  ingreso
  egreso
}

enum Currency { 
  PEN 
  USD 
}

enum TxnStatus { 
  ejecutado 
  anulado 
}

enum TxnSource { 
  manual
  loan
  installment
  reimbursement
  transfer
}

enum CycleStatus {
  abierto
  cerrado
  pagado
}

enum ShareStatus { 
  pendiente 
  cobrado 
}

enum DebtDirection {
  por_cobrar
  por_pagar
}

enum DebtStatus {
  pendiente
  pagado
}

model Account {
  id          Int         @id @default(autoincrement())
  userId      Int
  creditCardId  Int?
  name        String
  type        AccountType
  currency    Currency    @default(PEN)
  openingBalanceMinor BigInt @default(0)
  openingBalanceDate  DateTime @db.Date @default(dbgenerated("CURRENT_DATE"))
  creditLimit BigInt?
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  user        User        @relation(fields: [userId], references: [id])
  creditCard  CreditCard?  @relation(fields: [creditCardId], references: [id])

  fromTransfers Transfer[] @relation("FromAccount")
  toTransfers   Transfer[] @relation("ToAccount")
  transactions  Transaction[]
  loans         Loan[]
  recurringExpenses RecurringExpense[]

  @@map("accounts")
}

model Category {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  name      String
  type      TransactionType
  color     String?         @default("#eaeaea")
  icon      String?         @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  transactions Transaction[]
  loans        Loan[]
  installmentPlans  InstallmentPlan[]
  recurringExpenses RecurringExpense[]

  @@map("categories")
}

enum RateSide { 
  buy
  sell
}

model ExchangeRate {
  id             Int       @id @default(autoincrement())
  baseCurrency   String
  targetCurrency String
  rate           Float
  date           DateTime @db.Date
  source         String
  side           RateSide   @default(sell)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("exchange_rates")
}

model BillingCycle {
  id             Int       @id @default(autoincrement())
  userId         Int
  creditCardId      Int
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  dueDate        DateTime @db.Date
  bankAmount     BigInt?
  bankAmountUsd  BigInt?
  minimumPaymentMinor    BigInt?
  minimumPaymentUsdMinor BigInt?
  totalBalanceMinor      BigInt?
  totalBalanceUsdMinor   BigInt?
  lineUsedMinor          BigInt?
  paidAmountMinor        BigInt?
  paidAmountUsdMinor     BigInt?
  paidDate               DateTime? @db.Timestamptz(3)
  statementRegisteredAt  DateTime? @db.Timestamptz(3)
  status         CycleStatus @default(abierto)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  transactions  Transaction[]
  user          User           @relation(fields: [userId], references: [id])
  creditCard    CreditCard     @relation(fields: [creditCardId], references: [id])

  @@map("billing_cycles")
}

model Transaction {
  id            Int       @id @default(autoincrement())
  userId        Int
  accountId     Int
  categoryId    Int?
  type          TransactionType
  amount        BigInt
  amountBase    BigInt
  description   String?
  date          DateTime @db.Timestamptz(3)
  status        TxnStatus  @default(ejecutado)
  source        TxnSource  @default(manual)
  billingCycleId  Int?
  loanPaymentId   Int?
  installmentId   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  shares        TransactionShare[] @relation("ShareTransaction")
  user          User @relation(fields: [userId], references: [id])
  account       Account @relation(fields: [accountId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  billingCycle  BillingCycle? @relation(fields: [billingCycleId], references: [id])
  loanPayment   LoanPayment? @relation(fields: [loanPaymentId], references: [id])
  installment   Installment? @relation(fields: [installmentId], references: [id])
  reimbursementShares TransactionShare[] @relation("Reimbursement")
  fromTransfers Transfer[] @relation("FromTxn")
  toTransfers   Transfer[] @relation("ToTxn")
  debtPayments  ContactDebt[] @relation("DebtPayment")

  @@map("transactions")
}

model Transfer {
  id              Int   @id @default(autoincrement())
  userId          Int
  fromAccountId   Int
  toAccountId     Int
  fromAmount      BigInt
  toAmount        BigInt
  fromCurrency    Currency
  toCurrency      Currency
  rate            Float?
  date            DateTime
  description     String?
  fromTxnId       Int?
  toTxnId         Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user            User @relation(fields: [userId], references: [id])
  fromAccount     Account @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account @relation("ToAccount", fields: [toAccountId], references: [id])
  fromTxn         Transaction? @relation("FromTxn", fields: [fromTxnId], references: [id])
  toTxn           Transaction? @relation("ToTxn", fields: [toTxnId], references: [id])

  @@map("transfers")
}

model Contact {
  id              Int   @id @default(autoincrement())
  userId          Int
  name            String
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  transactionShares TransactionShare[]
  debts             ContactDebt[]
  user            User @relation(fields: [userId], references: [id])

  @@map("contacts")
}

model TransactionShare {
  id                  Int   @id @default(autoincrement())
  transactionId       Int
  contactId           Int
  amount              BigInt //Lo que debe, en la divisa de la transaccion
  status              ShareStatus
  paidDate            DateTime? @db.Timestamptz(3)
  settlementRate      Float? // TC usado para cobrar (PEN por USD, etc.)
  settlementCurrency  Currency? // divisa en que te pagó (ej. PEN)
  settlementAmount    BigInt? // monto recibido (en settlementCurrency)
  reimbursementTxnId  Int?  // Transaction ingreso real del cobro
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  transaction         Transaction   @relation("ShareTransaction", fields: [transactionId], references: [id])
  contact             Contact       @relation(fields: [contactId], references: [id])
  reimbursementTxn    Transaction?  @relation("Reimbursement", fields: [reimbursementTxnId], references: [id])

  @@map("transaction_shares")
}

enum LoanStatus { 
  activo 
  pagado 
}

model Loan {
  id                  Int   @id @default(autoincrement())
  userId              Int
  name                String
  currency            Currency
  principal           BigInt
  totalAmount         BigInt
  interestRate        Float?
  termMonths          Int
  startDate           DateTime @db.Date
  status              LoanStatus  @default(activo)
  accountId           Int?
  categoryId          Int?
  description         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  payments            LoanPayment[]
  user                User @relation(fields: [userId], references: [id])
  account             Account? @relation(fields: [accountId], references: [id])
  category            Category? @relation(fields: [categoryId], references: [id])

  @@map("loans")
}

enum PayStatus { 
  pendiente 
  parcial 
  pagado 
  atrasado 
}

model LoanPayment {
  id                  Int   @id @default(autoincrement())
  loanId              Int
  number              Int
  dueDate             DateTime @db.Date
  amount              BigInt   // cuota esperada (en divisa del préstamo)
  paidAmount          BigInt  @default(0) // acumulado de pagos (amortización parcial/total)
  status              PayStatus @default(pendiente)
  paidDate            DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  loan                Loan @relation(fields: [loanId], references: [id])
  transactions        Transaction[]

  @@map("loan_payments")
}

enum PlanStatus { 
  activo 
  pagado 
}

model InstallmentPlan {
  id                Int   @id @default(autoincrement())
  userId            Int
  creditCardId      Int
  categoryId        Int?
  description       String
  currency          Currency
  totalAmount       BigInt
  installments      Int
  amountPerInstallment  BigInt
  startDate         DateTime @db.Date
  firstDueDate      DateTime @db.Date
  status            PlanStatus    @default(activo)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user              User        @relation(fields: [userId], references: [id])
  creditCard        CreditCard  @relation(fields: [creditCardId], references: [id])
  category          Category?   @relation(fields: [categoryId], references: [id])
  installments_      Installment[]

  @@map("installment_plans")
}

model Installment {
  id                Int   @id @default(autoincrement())
  installmentPlanId Int
  number            Int
  dueDate           DateTime @db.Date
  amount            BigInt   // couta esperada
  paidAmount        BigInt @default(0)
  status            PayStatus @default(pendiente)
  paidDate          DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  installmentPlan   InstallmentPlan @relation(fields: [installmentPlanId], references: [id])
  transactions      Transaction[]


  @@map("installments")
}

model CreditCard {
  id                Int   @id @default(autoincrement())
  userId            Int
  name              String
  brand             String?
  bankCurrency      Currency?
  timezone          String   @default("America/Lima")
  isActive          Boolean @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user              User @relation(fields: [userId], references: [id])
  accounts          Account[]
  billingCycles     BillingCycle[]
  installmentPlans  InstallmentPlan[]

  @@map("credit_cards")
}

model RecurringExpense {
  id           Int       @id @default(autoincrement())
  userId       Int
  accountId    Int
  categoryId   Int?
  name         String
  amountMinor  BigInt
  currency     Currency
  dayOfMonth   Int
  isActive     Boolean   @default(true)
  lastRunMonth String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user     User      @relation(fields: [userId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("recurring_expenses")
}

model ContactDebt {
  id            Int           @id @default(autoincrement())
  userId        Int
  contactId     Int
  direction     DebtDirection
  description   String
  amountMinor   BigInt
  currency      Currency
  date          DateTime @db.Date
  dueDate       DateTime? @db.Date
  status        DebtStatus    @default(pendiente)
  paidDate      DateTime? @db.Timestamptz(3)
  transactionId Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id])
  contact     Contact     @relation(fields: [contactId], references: [id])
  transaction Transaction? @relation("DebtPayment", fields: [transactionId], references: [id])

  @@map("contact_debts")
}





